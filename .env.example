# ==============================================================================
# MyApp - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual secrets.
# NEVER commit your actual .env file to GitHub!
# ==============================================================================

# Database Connection (Prisma Postgres / PostgreSQL)
DATABASE_URL="postgres://username:password@localhost:5432/myapp?sslmode=require"

# Cache / Queue (Redis / BullMQ)
REDIS_URL="redis://localhost:6379"

# Application Authentication Secrets
JWT_SECRET="your_jwt_secret_key_here_change_in_production"

# RapidAPI (Optional fallback extractor for Instagram)
# Obtain key from: https://rapidapi.com/
RAPIDAPI_KEY="your_rapidapi_key_here"

# Server Port
PORT=5000

# Optional Frontend API override
# EXPO_PUBLIC_API_URL="https://your-backend-api.com"
